# Absolute origin of the deployed site. Used for canonical, og:url, og:image,
# robots.txt and sitemap.xml — all of which require absolute URLs.
# >>> SET THIS TO YOUR REAL DOMAIN BEFORE DEPLOYING <<<
VITE_SITE_URL=https://www.mohitbuilds.me/

# Optional: base URL of the portfolio API (Phase 3). When set, PageViews reads
# from `${VITE_API_URL}/v1/views` instead of the public counter service.
# VITE_API_URL=https://api.example.com
